# Inbox Rush - Environment Configuration

# Server Port
PORT=3001

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Session Secret
SESSION_SECRET=inbox_rush_arcade_secret_2026

# Google OAuth 2.0 Credentials (Optional for Demo Mode, Required for Real Gmail)
# Obtain these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
